{
  "name": "tradegrind-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TradeGrind • Real-Time Trading Simulation Monorepo",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta.bold,cyan.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "test": "npm run test --prefix server",
    "seed": "node server/src/config/seed.js",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.65.1",
    "@rollup/rollup-linux-x64-musl": "^4.65.1"
  }
}
